# Copier en .env et renseigner les valeurs (.env est gitignored).

# API Claude
ANTHROPIC_API_KEY=a_remplacer

# Connexion à la base PostgreSQL locale (service `db` de compose.yaml).
# Noms standard libpq : lus nativement par psql et psycopg.
PGHOST=localhost
PGPORT=5432
PGDATABASE=assistant_regles
PGUSER=assistant_regles
PGPASSWORD=a_remplacer

# Modèles Hugging Face : utiliser uniquement le cache local (pas d'appel réseau)
HF_HUB_OFFLINE=1